{
  "name": "hermes-nextjs-fullstack-starter",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/package-release.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test .tests/unit/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx .tests/integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "predev": "npm run db:migrate"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@tanstack/react-table": "9.3.1",
    "bcryptjs": "3.0.3",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "lucide-react": "1.56.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "tough-cookie": "6.0.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "es-toolkit": "1.52.0",
    "immer": "11.2.3",
    "victory-vendor": "37.3.6"
  }
}
