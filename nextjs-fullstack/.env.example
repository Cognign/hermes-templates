# Optional. Without DATABASE_URL the app uses an embedded PGlite database in
# $DATA_DIR/pglite (default ./.data/pglite). With APP_ENV=production it is required.
# DATABASE_URL=postgresql://app:local-development-only@127.0.0.1:5432/app
# DATA_DIR=./.data
# Set to false only for plain HTTP on a host that is not localhost.
# SESSION_COOKIE_SECURE=false
